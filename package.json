{
  "name": "n8n-nodes-pdfmint",
  "version": "0.2.0",
  "description": "Turn HTML, Markdown or a URL into a PDF and get the file back on the same node. No template editor, no template IDs, no self-hosted container.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "pdf",
    "html-to-pdf",
    "markdown-to-pdf",
    "invoice",
    "report",
    "pdfmint"
  ],
  "license": "MIT",
  "homepage": "https://pdfmint-b9tt.onrender.com",
  "author": {
    "name": "Florian Standhartinger",
    "email": "florian.standhartinger@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fstandhartinger/n8n-nodes-pdfmint.git"
  },
  "bugs": {
    "url": "https://github.com/fstandhartinger/n8n-nodes-pdfmint/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build && rm -rf dist/docs dist/package.json dist/tsconfig.tsbuildinfo && find dist -name '*.js.map' -delete",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "release": "n8n-node release",
    "prerelease": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PdfMintApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PdfMint/PdfMint.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.44.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
